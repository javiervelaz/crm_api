{
    "version": 2,
    "builds": [
      {
        "src": "node.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "node.js"
      }
    ],
    "crons": [
      {
      "path": "/api/cron/expire-tiers",
      "schedule": "0 3 * * *"
      }
    ]
  }
  