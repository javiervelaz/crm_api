+-- migrations/010_gastos_sin_caja.sql
+--
+-- Gastos sin caja abierta.
+--
+-- Abrir caja es parte del módulo 'operaciones' (pedidos). Un tenant sin ese
+-- módulo (ej. rubro educación) no tiene caja que abrir, pero sí gastos que
+-- registrar. Para esos tenants salida_caja.registro_diario_id queda NULL y el
+-- gasto se ubica en el tiempo por created_at.
+--
+-- La regla (exigir caja sólo si el tenant tiene 'operaciones' activo) vive en
+-- services/salidaCaja/salidaCajaService.js. Gastronomía no cambia: para ellos
+-- registro_diario_id sigue siendo obligatorio.
+--
+-- Idempotente.
+
+BEGIN;
+
+ALTER TABLE salida_caja ALTER COLUMN registro_diario_id DROP NOT NULL;
+
+-- Listado de gastos por período (GET /api/salida-caja/periodo)
+CREATE INDEX IF NOT EXISTS salida_caja_cliente_created_idx
+  ON salida_caja (cliente_id, created_at);
+
+COMMIT;
diff --git a/model/salida_caja/db.js b/model/salida_caja/db.js
index e764555..07c1f58 100644
--- a/model/salida_caja/db.js
+++ b/model/salida_caja/db.js
@@ -82,7 +82,42 @@ const createSalidaCaja  = async (RegistroDiario) => {
   };
   
   
+  // ¿El tenant trabaja con caja? Abrir caja es parte del módulo 'operaciones':
+  // sin él (rubro educación, por ejemplo) los gastos se cargan sin registro diario.
+  const tenantUsaCaja = async (cliente_id) => {
+    const result = await pool.query(
+      `SELECT EXISTS (
+         SELECT 1 FROM modulo
+          WHERE cliente_id = $1::int AND codigo = 'operaciones'
+            AND status = true AND deleted_at IS NULL
+       ) AS usa_caja`,
+      [cliente_id]
+    );
+    return result.rows[0].usa_caja === true;
+  };
+
+  // Gastos entre dos fechas (inclusive), en hora de Córdoba. created_at se
+  // guarda en UTC sin zona (default CURRENT_TIMESTAMP de la sesión de Neon).
+  const getSalidasCajasPorPeriodo = async (cliente_id, desde, hasta) => {
+    const result = await pool.query(
+      `SELECT sc.id, sc.descripcion, sc.monto, sc.categoria_salida_id,
+              sc.registro_diario_id, sc.usuario_id, sc.created_at,
+              ct.descripcion AS categoria_nombre,
+              (sc.created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Argentina/Cordoba')::date AS fecha
+         FROM salida_caja sc
+         LEFT JOIN categoria_tipo ct ON sc.categoria_salida_id = ct.id
+        WHERE sc.cliente_id = $1::int
+          AND (sc.created_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Argentina/Cordoba')::date
+              BETWEEN $2::date AND $3::date
+        ORDER BY sc.created_at DESC`,
+      [cliente_id, desde, hasta]
+    );
+    return result.rows;
+  };
+
   module.exports = {
+    tenantUsaCaja,
+    getSalidasCajasPorPeriodo,
     createSalidaCaja,
     getSalidaCajaById,
     getSalidasCajas,
