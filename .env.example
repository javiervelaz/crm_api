# OBLIGATORIO — usar un string aleatorio seguro (ej: openssl rand -hex 32)
JWT_SECRET=change-me
POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
# OBLIGATORIO — usar un string aleatorio seguro distinto al JWT_SECRET
HANDOFF_JWT_SECRET=change-me
HANDOFF_TTL_SECONDS=600

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MercadoPago
# Para desarrollo/sandbox usar token TEST-... del panel de desarrolladores:
# https://www.mercadopago.com.ar/developers/panel/app → tu app → Credenciales de prueba
# Para produccion usar token APP_USR-...
MP_MOCK=false
MERCADOPAGO_ACCESS_TOKEN=TEST-your-test-access-token-here
# Email del buyer test user (crear en: POST https://api.mercadopago.com/users/test)
MERCADOPAGO_TEST_PAYER_EMAIL=test_user_buyer@testuser.com
# En dev usar URL de ngrok: ngrok http 3001 → https://xxxx.ngrok-free.app
MERCADOPAGO_WEBHOOK_URL=https://30d7-190-189-31-126.ngrok-free.app/api/billing/webhook
# OBLIGATORIO en producción — obtener desde panel MP → tu app → Webhooks → Secret key
MP_WEBHOOK_SECRET=your-webhook-secret
FRONTEND_SUCCESS_URL=http://localhost:3000/dashboard/plan?status=success
FRONTEND_FAILURE_URL=http://localhost:3000/dashboard/plan?status=failure

PLATFORM_LOGIN_URL=http://localhost:3000/

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

META_WABA_ID=your-waba-id
META_ACCESS_TOKEN=your-meta-token
N8N_INTERNAL_TOKEN=your-n8n-token

CORS_ORIGINS=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────
# Provider de envío: resend | smtp | console
# En dev dejalo en 'console': los mails se imprimen por stdout y nadie manda
# pruebas a la casilla de un cliente real por tener el .env mal.
EMAIL_PROVIDER=console
# Panel de Resend → API Keys → permiso "Sending access"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Tiene que ser un dominio verificado en Resend con DKIM + SPF + DMARC
EMAIL_FROM=info@countercrm.com
EMAIL_FROM_NAME=Counter
EMAIL_REPLY_TO=info@countercrm.com
# Reintentos con backoff exponencial: 1, 2, 4, 8, 16 minutos
EMAIL_MAX_ATTEMPTS=5
# Cuántos mails drena por corrida el cron/worker
EMAIL_DRAIN_BATCH=20
# Minutos tras los que se rescata un lock huérfano (lambda muerta a mitad)
EMAIL_LOCK_STALE_MIN=5
# Timeout del POST a la API del provider
EMAIL_HTTP_TIMEOUT_MS=10000
# Solo para scripts/emailWorker.js (VPS). En Vercel no aplica.
EMAIL_WORKER_INTERVAL_MS=15000

# ─── Verificación / activación de cuenta ──────────────────────────────────
# Días que vive el link de activación que va en el mail de bienvenida
VERIFICACION_TTL_DIAS=7
# Días sin verificar tras los cuales la cuenta pasa a BLOQUEADO (cron diario)
VERIFICACION_BLOQUEO_DIAS=30
