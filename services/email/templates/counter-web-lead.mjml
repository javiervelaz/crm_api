<mjml>
  <mj-include path="./partials/head.mjml" />
  <mj-head>
    <mj-style>
      .mensaje div { white-space: pre-line; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5f9" width="560px">
    <mj-section background-color="#261734" padding="24px 24px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="700" letter-spacing="0.5px" padding="0">
          counter
        </mj-text>
        <mj-text align="center" color="#FF992D" font-size="12px" letter-spacing="2px" padding="4px 0 0 0">
          NUEVO CONTACTO WEB
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="32px 32px 8px 32px">
      <mj-column>
        <mj-text font-size="22px" line-height="30px" font-weight="700" color="#0f172a" padding="0">
          {{nombre}}{{#if negocio}} · {{negocio}}{{/if}}
        </mj-text>
        <mj-text font-size="13px" color="#64748b" padding="6px 0 0 0">
          Lead #{{leadId}}{{#if rubro}} · {{rubro}}{{/if}} · llegó desde la landing de Counter
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 32px 8px 32px">
      <mj-column background-color="#f8fafc" border-radius="10px" padding="16px">
        <mj-text font-size="12px" font-weight="700" color="#4B2D67" letter-spacing="1px" padding="0">
          QUÉ NECESITA
        </mj-text>
        <mj-text css-class="mensaje" color="#0f172a" padding="8px 0 0 0">{{mensaje}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 32px 8px 32px">
      <mj-column>
        <mj-text padding="0">
          <strong style="color:#0f172a">WhatsApp:</strong> {{#if whatsapp}}{{whatsapp}}{{else}}—{{/if}}<br />
          <strong style="color:#0f172a">Email:</strong> {{#if email}}{{email}}{{else}}—{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    {{#if whatsappUrl}}
    <mj-section padding="16px 32px 8px 32px">
      <mj-column>
        <mj-button href="{{url whatsappUrl}}" align="left" background-color="#FF992D">
          Responder por WhatsApp
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}

    <mj-section padding="8px 32px 28px 32px">
      <mj-column>
        <mj-text font-size="13px" color="#94a3b8" padding="0">
          {{#if email}}Si respondés este mail, le llega directo a {{email}}.{{else}}No dejó email: contactalo por WhatsApp.{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f8fafc" padding="20px 24px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8" padding="0">
          Aviso interno de counter-web · Córdoba, Argentina
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
